# Copy these into Vercel → Project → Settings → Environment Variables.
# Configure at least one lead destination.

# Production URL (canonical links + sitemap)
SITE_URL=https://www.callharbison.com

# Email alerts via Resend (resend.com). LEAD_NOTIFY_EMAIL can be comma-separated.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Must be on a domain verified in Resend, e.g. "Harbison Leads <leads@callharbison.com>"
LEAD_FROM_EMAIL=

# Store leads in Supabase (run supabase/schema.sql first). Server-side only — never expose this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forward leads to Zapier / Make / GoHighLevel / CRM (for SMS alerts, follow-up automations, etc.)
LEAD_WEBHOOK_URL=

# Google Analytics 4 (optional)
GA_MEASUREMENT_ID=

# Google Tag Manager (recommended over raw GA4 once Ads conversions + call tracking are added)
GTM_ID=

# Instant text to the lead + staff alert (Twilio). Requires A2P 10DLC registration before US texting works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated staff numbers to alert on every new lead
LEAD_ALERT_SMS=

# HQ panel at /hq (dashboard + CRM). Use a long, unique password; changing it signs everyone out.
HQ_PASSWORD=
# Optional: separate secret for signing HQ sessions (otherwise derived from HQ_PASSWORD + service key)
HQ_SESSION_SECRET=
