# Copy these into Vercel → Project → Settings → Environment Variables.
# Configure at least one lead destination.

# Production URL (canonical links + sitemap)
SITE_URL=https://www.harbisonbuyshomes.com

# Email alerts via Resend (resend.com). LEAD_NOTIFY_EMAIL can be comma-separated.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Must be on a domain verified in Resend, e.g. "Harbison Leads <leads@harbisonbuyshomes.com>"
LEAD_FROM_EMAIL=

# Store leads in Supabase (run supabase/schema.sql first). Server-side only — never expose this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forward leads to Zapier / Make / GoHighLevel / CRM (for SMS alerts, follow-up automations, etc.)
LEAD_WEBHOOK_URL=

# Google Analytics 4 (optional)
GA_MEASUREMENT_ID=
